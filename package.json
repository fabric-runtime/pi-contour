{
  "name": "pi-contour",
  "version": "0.4.6",
  "description": "Evidence-first structural review of code changes, powered by Fovea's heat-diffusion substrate.",
  "type": "module",
  "license": "MIT",
  "author": "monotykamary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabric-runtime/pi-contour.git"
  },
  "homepage": "https://github.com/fabric-runtime/pi-contour#readme",
  "bugs": "https://github.com/fabric-runtime/pi-contour/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "code-review",
    "heat-diffusion"
  ],
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/fabric-runtime/pi-contour/main/media/preview.png"
  },
  "bin": {
    "contour": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "docs",
    "media"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:dead": "knip",
    "check:fast": "bun run typecheck && bun run test:changed",
    "test:changed": "node scripts/test-affected.mjs",
    "test:affected": "node scripts/test-affected.mjs --base $PI_TEST_BASE",
    "test:related": "vitest related",
    "test:smoke": "vitest run tests/background.test.ts tests/docs.test.ts tests/metrics.test.ts tests/render.test.ts tests/startup.test.ts",
    "build": "tsx scripts/build.ts",
    "bench": "tsx scripts/bench.ts",
    "cover": "tsx scripts/cover.ts",
    "verify:package": "tsx scripts/verify-package.ts",
    "smoke": "tsx scripts/smoke.ts",
    "prepack": "bun run build",
    "contour": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "knip": "^6.32.0",
    "pi-fovea": "0.27.0",
    "tsx": "^4.19.0",
    "typebox": "1.3.27",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  }
}
